# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw photo exports (~35MB of full-resolution originals). The web-ready
# versions live in public/slides/ and ARE committed; keep the originals out
# of git history. Safe to delete locally once you have them backed up.
#
# Matched on the "Slide N - " export naming rather than "Slide*", because
# git runs case-insensitively here and "Slide*" also swallows public/slides/.
/public/Slide [0-9] - */
!/public/slides/
